# ====================================================================
# zm-sso.properties — Staging Config (Fase 8)
# All features DISABLED by default for gradual rollout.
# Enable one-by-one for pilot group, per plan §9.
# ====================================================================

# --- OIDC Core (must match your Keycloak realm) ---
sso.defaultClient = oidc
sso.callbackUrl = https://<YOUR-ZIMBRA-HOST>/service/extension/oidc/callback
oidc.callbackUrl = https://<YOUR-ZIMBRA-HOST>/service/extension/oidc/callback
oidc.discoveryUri = https://<YOUR-KEYCLOAK-HOST>/realms/<YOUR-REALM>/.well-known/openid-configuration
oidc.id = <YOUR-CLIENT-ID>
oidc.scope = openid,profile,email
oidc.preferredJwsAlgorithm = RS256
oidc.useNonce = false
oidc.withState = true
oidc.clientAuthenticationMethod = client_secret_basic

# --- Logout Token Validation ---
oidc.logoutToken.issuer = https://<YOUR-KEYCLOAK-HOST>/realms/<YOUR-REALM>
oidc.logoutToken.clientId = <YOUR-BACKCHANNEL-CLIENT-ID>
oidc.logoutToken.jwsAlgorithm = RS256
oidc.logoutToken.jwksUrl = https://<YOUR-KEYCLOAK-HOST>/realms/<YOUR-REALM>/protocol/openid-connect/certs

# --- Feature Flags (ALL DISABLED for staging) ---
# Phase 8.1: Install artifact with all features disabled.
# Phase 8.6: Enable back-channel for pilot group only.
# Phase 8.8: Enable heartbeat for pilot group only.
# Phase 8.10: Enable watchdog after proving individual revocation.

oidc.sessionSync.enabled = false
oidc.sessionSync.backchannelEnabled = false
oidc.sessionSync.watchdogEnabled = false
oidc.sessionSync.failClosed = true

# --- Timing ---
oidc.sessionSync.heartbeatIntervalSeconds = 60
oidc.sessionSync.minimumServerIntervalSeconds = 30
oidc.sessionSync.activityGraceSeconds = 1500
oidc.sessionSync.hiddenTabGraceSeconds = 120
oidc.sessionSync.refreshBeforeExpirySeconds = 60
oidc.sessionSync.transientFailureGraceSeconds = 180
oidc.sessionSync.maxTransientFailures = 3

# --- Watchdog ---
oidc.sessionSync.watchdogIntervalSeconds = 60
oidc.sessionSync.watchdogBatchSize = 100

# --- Security ---
oidc.sessionSync.allowedOrigin = https://<YOUR-ZIMBRA-HOST>
# 0 = use Keycloak absolute_max_seconds; set >0 to enforce hard cap (seconds)
oidc.sessionSync.absoluteMaxSeconds = 0
